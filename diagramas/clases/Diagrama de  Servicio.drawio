        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam packageStyle rectangle\n\ntitle Capa de Aplicación - CargoBox\n\npackage \&quot;Application Layer - Coordinación de Casos de Uso\&quot; {\n\n    class EnvioAppService &lt;&lt;Application Service&gt;&gt; {\n        - envioRepository : IEnvioRepository\n        --\n        + recibirPaquete(datos: EnvioDTO, seguro: Decimal) : String\n        + cancelarEnvio(numeroGuia: String) : boolean\n        + cambiarDireccionDestino(numeroGuia: String, nuevaDireccion: DireccionDTO) : boolean\n        + reportarIntentoFallido(numeroGuia: String, motivo: String) : void\n        + registrarEntregaExitosa(numeroGuia: String, archivoEvidencia: Object) : void\n    }\n\n    class EnvioDTO &lt;&lt;Data Transfer Object&gt;&gt; {\n        + remitente : String\n        + destinatario : String\n        + codigoPostalDestino : String\n        + tipoServicio : String\n    }\n\n    interface IEnvioRepository &lt;&lt;Interface&gt;&gt; {\n        + obtenerPorGuia(numeroGuia: String) : Envio\n        + guardar(envio: Envio) : void\n    }\n    \n    class Envio &lt;&lt;Aggregate Root&gt;&gt; {\n        + actualizarDireccion(nuevaDireccion: Direccion)\n        + registrarIntentoFallido(motivo: String)\n    }\n\n    EnvioAppService ..&gt; IEnvioRepository : usa\n    EnvioAppService ..&gt; Envio : delega reglas a &gt;\n    EnvioAppService ..&gt; EnvioDTO : recibe &gt;\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="K80lynGgQNqnLTQV6aHG-34">
