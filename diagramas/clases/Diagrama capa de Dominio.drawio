        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\nskinparam monochrome true\nskinparam packageStyle rectangle\n\ntitle Capa de Dominio - CargoBox\n\npackage \&quot;Domain Layer - Reglas y Conceptos\&quot; {\n\n    enum EstadoEnvio {\n        RECIBIDO\n        EN_TRANSITO\n        REPROGRAMADO\n        ENTREGADO\n        CANCELADO\n    }\n\n    class Envio &lt;&lt;Aggregate Root&gt;&gt; {\n        + numeroGuia : String\n        + estado : EstadoEnvio\n        + intentosEntrega : Integer\n        + fechaRegistro : DateTime\n        --\n        + Envio(datosRemitente: String, datosDestinatario: String)\n        + cancelarEnvio() : void\n        + actualizarDireccion(nuevaDireccion: Direccion) : void\n        + registrarIntentoFallido(motivo: String) : void\n        + registrarEvidencia(fotoFirma: String) : void\n        - validarReglaMenosDeDosIntentos() : boolean\n    }\n\n    class Paquete &lt;&lt;Entity&gt;&gt; {\n        + codigoInterno : String\n        + contenidoGeneral : String\n        + estadoFisico : String\n        --\n        + reportarDaño(evidencia: String) : void\n    }\n\n    class Direccion &lt;&lt;Value Object&gt;&gt; {\n        + calle : String\n        + numero : String\n        + colonia : String\n        + codigoPostal : String\n    }\n\n    class Seguro &lt;&lt;Value Object&gt;&gt; {\n        + montoDeclarado : Decimal\n        + tieneCobertura : boolean\n    }\n\n    class IntentoEntrega &lt;&lt;Value Object&gt;&gt; {\n        + fechaIntento : DateTime\n        + motivoFallo : String\n    }\n\n    interface IEnvioRepository &lt;&lt;Interface&gt;&gt; {\n        + obtenerPorGuia(numeroGuia: String) : Envio\n        + guardar(envio: Envio) : void\n    }\n\n    Envio \&quot;1\&quot; *-- \&quot;1\&quot; Direccion : destino &gt;\n    Envio \&quot;1\&quot; *-- \&quot;0..1\&quot; Seguro : ampara &gt;\n    Envio \&quot;1\&quot; *-- \&quot;1\&quot; Paquete : transporta &gt;\n    Envio \&quot;1\&quot; *-- \&quot;0..2\&quot; IntentoEntrega : registra &gt;\n    Envio -right-&gt; EstadoEnvio\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="zYQ2NDWupJxqCPaU2VJv-50">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
