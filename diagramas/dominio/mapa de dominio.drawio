        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nhide empty members\nskinparam classAttributeIconSize 0\n\npackage \&quot;Dominio de Envíos (CargoBox)\&quot; {\n    \n    enum EstadoEnvio {\n        RECIBIDO\n        EN_TRANSITO\n        REPROGRAMADO\n        ENTREGADO\n        CANCELADO\n    }\n\n    class Envío &lt;&lt;Aggregate Root&gt;&gt; {\n        + numeroGuia : string\n        + estado : EstadoEnvio\n        + cancelar()\n        + actualizarDireccion(nueva: Direccion)\n        + registrarIntentoFallido(motivo: string)\n    }\n\n    class Paquete &lt;&lt;Entity&gt;&gt; {\n        + descripcion : string\n        + estadoFisico : string\n    }\n\n    class Direccion &lt;&lt;Value Object&gt;&gt; {\n        + calle : string\n        + codigoPostal : string\n    }\n\n    class Seguro &lt;&lt;Value Object&gt;&gt; {\n        + montoDeclarado : decimal\n    }\n\n    class IntentoEntrega &lt;&lt;Value Object&gt;&gt; {\n        + fecha : DateTime\n        + motivo : string\n    }\n\n    Envío \&quot;1\&quot; *-- \&quot;1\&quot; Direccion\n    Envío \&quot;1\&quot; *-- \&quot;0..1\&quot; Seguro\n    Envío \&quot;1\&quot; *-- \&quot;1\&quot; Paquete\n    Envío \&quot;1\&quot; *-- \&quot;0..2\&quot; IntentoEntrega\n    Envío -right-&gt; EstadoEnvio\n}\n\npackage \&quot;Domain Services y Eventos\&quot; {\n    \n    class CentroDistribucion &lt;&lt;Entity&gt;&gt; {\n        + nombre : string\n        + codigoPostalAsignado : string\n    }\n\n    class AsignadorCentroDistribucion &lt;&lt;Domain Service&gt;&gt; {\n        + sugerirCentro(codigoPostal: string): CentroDistribucion\n    }\n\n    class EventosDeDominio &lt;&lt;Domain Event&gt;&gt; {\n        + EnvioCancelado\n        + IntentoEntregaFallido\n        + PaqueteEntregado\n    }\n    \n    AsignadorCentroDistribucion ..&gt; CentroDistribucion : recupera\n    Envío ..&gt; EventosDeDominio : dispara\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LHz7vmU5yqRxGmyf3mrf-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
